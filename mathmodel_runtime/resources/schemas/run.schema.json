{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmodel.local/schemas/run.schema.json",
  "type": "object",
  "required": [
    "run_id",
    "argv",
    "cwd",
    "inputs",
    "code",
    "outputs",
    "started_at",
    "status",
    "exit_code"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "code": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "status": {
      "enum": [
        "running",
        "succeeded",
        "failed",
        "timeout",
        "invalid_outputs",
        "source_changed"
      ]
    },
    "actual_argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "executable": {
      "type": "string",
      "minLength": 1
    },
    "resolved_executable": {
      "type": "string",
      "minLength": 1
    }
  }
}
