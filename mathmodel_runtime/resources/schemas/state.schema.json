{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmodel.local/schemas/state.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "revision",
    "project",
    "gates",
    "phases",
    "runs",
    "artifacts",
    "claims",
    "review_tasks",
    "completed",
    "checkpoints"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "project": {
      "$ref": "project.schema.json"
    },
    "runs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "run.schema.json"
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "artifact.schema.json"
      }
    },
    "gates": {
      "type": "object"
    },
    "phases": {
      "type": "object"
    },
    "claims": {
      "type": "object"
    },
    "review_tasks": {
      "type": "object"
    },
    "completed": {
      "type": "boolean"
    },
    "checkpoints": {
      "type": "array"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["input_id", "kind", "filename", "label", "path", "sha256", "bytes", "mime_type", "imported_at", "extraction", "stale"],
        "properties": {
          "input_id": {"type": "string", "pattern": "^input_[0-9a-f]{16}$"},
          "kind": {"enum": ["problem", "attachment", "paper-template", "paper-requirements"]},
          "filename": {"type": "string", "minLength": 1},
          "label": {"type": "string"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "mime_type": {"type": "string"},
          "imported_at": {"type": "string"},
          "stale": {"type": "boolean"},
          "extraction": {
            "type": "object",
            "required": ["status", "method", "notice"],
            "properties": {
              "status": {"enum": ["not-extracted", "extracted", "partial", "blocked", "failed"]},
              "method": {"type": ["string", "null"]},
              "notice": {"type": "string"},
              "path": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "bytes": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  }
}
