{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmodel.local/schemas/project.schema.json",
  "type": "object",
  "required": [
    "project_id",
    "projectRoot",
    "scope",
    "paperFormat",
    "subproblems",
    "authorId",
    "rules",
    "profile"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "projectRoot": {
      "type": "string",
      "minLength": 1
    },
    "skillRoot": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "full",
        "modeling",
        "programming",
        "paper"
      ]
    },
    "paperFormat": {
      "enum": [
        "word",
        "latex",
        "word+latex"
      ]
    },
    "profile": {
      "enum": [
        "balanced",
        "short",
        "competition"
      ]
    },
    "subproblems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^q[1-9][0-9]*$"
      }
    },
    "authorId": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "object"
    },
    "optionalCollab": {
      "type": "object",
      "properties": {
        "rulesCheck": {"type": "boolean"},
        "attachmentInventory": {"type": "boolean"},
        "literature": {"type": "boolean"},
        "prototype": {"type": "boolean"},
        "experiments": {"type": "boolean"},
        "bilingual": {"type": "boolean"},
        "terminology": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "graphicsTools": {
      "type": "object",
      "properties": {
        "scientific-visualization": {"const": true},
        "matplotlib": {"const": true},
        "scienceplots": {"type": "boolean"},
        "drawio": {"type": "boolean"},
        "scientific-schematics": {"type": "boolean"},
        "scivis-agent-skills": {"type": "boolean"},
        "seaborn": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "paperRequirements": {
      "type": ["object", "string"],
      "required": ["text", "source"],
      "properties": {"text": {"type": "string"}, "source": {"type": "string"}},
      "additionalProperties": false
    }
  }
}
