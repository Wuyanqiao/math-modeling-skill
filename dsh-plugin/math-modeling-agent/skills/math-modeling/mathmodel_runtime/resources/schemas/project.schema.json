{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmodel.local/schemas/project.schema.json",
  "type": "object",
  "required": [
    "project_id",
    "projectRoot",
    "scope",
    "paperFormat",
    "subproblems",
    "authorId",
    "rules",
    "profile"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "projectRoot": {
      "type": "string",
      "minLength": 1
    },
    "skillRoot": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "full",
        "modeling",
        "programming",
        "paper"
      ]
    },
    "paperFormat": {
      "enum": [
        "word",
        "latex",
        "word+latex"
      ]
    },
    "profile": {
      "enum": [
        "balanced",
        "short",
        "competition"
      ]
    },
    "subproblems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^q[1-9][0-9]*$"
      }
    },
    "authorId": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "object"
    }
  }
}
