{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmodel.local/schemas/artifact.schema.json",
  "type": "object",
  "required": [
    "artifact_id",
    "path",
    "kind",
    "sha256",
    "validation"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "model",
        "terms",
        "code",
        "table",
        "figure",
        "document",
        "pdf",
        "manifest",
        "outline",
        "other"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "question": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "validation": {
      "type": "object"
    }
  }
}
